{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Photo Collage",
  "nameJa": "写真コラージュ",
  "slug": "photo-collage",
  "version": "0.9.0",
  "description": "Combine multiple photos into one collage directly in your browser.",
  "descriptionJa": "複数の写真をブラウザー内で1枚のコラージュにまとめます。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-photo-collage"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
